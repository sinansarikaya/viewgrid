{
  "name": "viewgrid",
  "version": "0.1.0",
  "private": true,
  "description": "ViewGrid — multi-viewport responsive testing workspace for Firefox (WebExtension)",
  "type": "module",
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/build.mjs --target=firefox",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:chromium": "node scripts/build.mjs --target=chromium",
    "dev:firefox": "npm run build:firefox && web-ext run --source-dir dist",
    "lint": "eslint .",
    "lint:web-ext": "web-ext lint --source-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "web-ext": "^8.3.0"
  }
}
